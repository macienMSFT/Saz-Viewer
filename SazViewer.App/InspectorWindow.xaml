<Window x:Class="SazViewer.App.InspectorWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SazViewer.App.Views"
        Width="1100" Height="760" MinWidth="420" MinHeight="300"
        Background="{DynamicResource Saz.Bg}"
        Foreground="{DynamicResource Saz.Text}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
    <views:InspectorView x:Name="Inspector" />
</Window>
