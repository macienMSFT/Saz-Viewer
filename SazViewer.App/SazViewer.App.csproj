<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>SazViewer.App</AssemblyName>
    <RootNamespace>SazViewer.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\SazViewer.ico</ApplicationIcon>
    <!-- Precompiled code (only when publishing for a runtime) cuts JIT time at launch. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SazViewer.Core\SazViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and taskbar icon; regenerate with Assets\Generate-Icon.ps1. -->
    <Resource Include="Assets\SazViewer.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SazViewer.App.Tests" />
  </ItemGroup>

</Project>
