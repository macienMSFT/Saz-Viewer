<UserControl x:Class="SazViewer.App.Views.StructuredBodyView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views"
             xmlns:controls="clr-namespace:SazViewer.App.Controls">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <DockPanel>
        <controls:RichLine DockPanel.Dock="Top" Line="{Binding MetaLine}" Version="{Binding MetaLine.Version}"
                           TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource Saz.Text}"
                           Visibility="{Binding MetaLine, Converter={StaticResource NotNullToVisibility}}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"
                    AutomationProperties.Name="{Binding ModeGroupName}" KeyboardNavigation.TabNavigation="Once"
                    KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton Style="{StaticResource Saz.ButtonBase}" Content="Tree" Margin="0,0,2,0"
                         IsChecked="{Binding IsTreeMode, Mode=TwoWay}"
                         AutomationProperties.Name="Tree" />
            <RadioButton Style="{StaticResource Saz.ButtonBase}" Content="Formatted Text"
                         IsChecked="{Binding IsFormattedMode, Mode=TwoWay}"
                         AutomationProperties.Name="Formatted Text" />
        </StackPanel>
        <ContentControl Content="{Binding ActiveView}" Focusable="False" />
    </DockPanel>
</UserControl>
