<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SazViewer.App.ViewModels"
                    xmlns:views="clr-namespace:SazViewer.App.Views">
    <!-- Implicit templates mapping tab-content view-models to their native views. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SazViewer.App;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <views:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />

    <!-- Shared DataGrid styles (session grid and WebSocket message list). -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="GridNumberText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="GridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Saz.Muted}" />
            <Setter Property="Background" Value="{DynamicResource Saz.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Saz.Line}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Saz.InsetFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <TextBlock x:Name="SortGlyph" DockPanel.Dock="Right" Margin="4,0,0,0" Foreground="{DynamicResource Saz.Accent}" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortGlyph" Property="Text" Value="▲" />
                                <Setter Property="Foreground" Value="{DynamicResource Saz.Text}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortGlyph" Property="Text" Value="▼" />
                                <Setter Property="Foreground" Value="{DynamicResource Saz.Text}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Saz.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- Overrides the theme's selected/inactive-selection system text brushes. -->
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="0,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Saz.Selected}" />
                    <Setter Property="Foreground" Value="{DynamicResource Saz.SelectedText}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Saz.Text}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Saz.InsetFocusVisual}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Saz.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Saz.Selected}" />
                    <Setter Property="Foreground" Value="{DynamicResource Saz.SelectedText}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    <DataTemplate DataType="{x:Type vm:TextDocumentViewModel}">
        <views:LineDocumentView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StructuredBodyViewModel}">
        <views:StructuredBodyView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ValueTreeViewModel}">
        <views:ValueTreeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HexViewModel}">
        <views:HexView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AuthViewModel}">
        <views:AuthView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ImageViewModel}">
        <views:ImageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WebPreviewViewModel}">
        <views:WebPreviewView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MapiViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource Saz.Muted}" FontSize="11"
                           Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Saz.Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Saz.Warning}"
                    Visibility="{Binding WarningText, Converter={StaticResource NotNullToVisibility}}">
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <TextBox Text="{Binding WarningText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource Saz.Text}" Padding="0"
                             AutomationProperties.Name="MAPI parser warnings" />
                </ScrollViewer>
            </Border>
            <ContentControl Content="{Binding Tree}" Focusable="False" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Saz.Muted}" TextWrapping="Wrap" Margin="4" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MessagePaneViewModel}">
        <views:MessagePaneView />
    </DataTemplate>
</ResourceDictionary>
