<UserControl x:Class="SazViewer.App.Views.WebSocketInspectorView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PaneHeading" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
            </Style>
            <Style x:Key="Pane" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Saz.Line}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource Saz.Panel}" />
            </Style>
            <Style x:Key="MessageText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="5,0" />
                <Setter Property="FontFamily" Value="{StaticResource Saz.MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Layout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TrafficColumn" Width="38*" MinWidth="280" />
            <ColumnDefinition x:Name="SplitterColumn" Width="8" />
            <ColumnDefinition x:Name="DetailColumn" Width="62*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TrafficRow" Height="*" />
            <RowDefinition x:Name="GapRow" Height="0" />
            <RowDefinition x:Name="DetailRow" Height="0" />
        </Grid.RowDefinitions>

        <!-- Chronological traffic: payload filter and the logical message list. -->
        <Border x:Name="TrafficPane" Grid.Column="0" Grid.Row="0" Style="{StaticResource Pane}"
                AutomationProperties.Name="Chronological WebSocket traffic">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="WebSocket traffic" Style="{StaticResource PaneHeading}" />
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Saz.Line}" BorderThickness="0,1,0,0" />
                <Border DockPanel.Dock="Top" Style="{StaticResource Saz.Warning}" Margin="6,6,6,0"
                        Visibility="{Binding OmittedWarning, Converter={StaticResource NotNullToVisibility}}">
                    <TextBlock Text="{Binding OmittedWarning}" TextWrapping="Wrap" />
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SearchStatus}" Foreground="{DynamicResource Saz.Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite" />
                    <TextBox x:Name="FilterBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=120}" MaxLength="4096"
                             Tag="Search WebSocket payloads..." ToolTip="{Binding SearchHelp}"
                             AutomationProperties.Name="Search WebSocket payloads"
                             AutomationProperties.HelpText="{Binding SearchHelp}"
                             PreviewKeyDown="OnFilterKeyDown" />
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="MessageGrid"
                              ItemsSource="{Binding VisibleItems}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{DynamicResource Saz.Line}" VerticalGridLinesBrush="{DynamicResource Saz.Line}"
                              Background="{DynamicResource Saz.Bg}" RowBackground="Transparent" Foreground="{DynamicResource Saz.Text}"
                              BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Saz.Line}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              CellStyle="{StaticResource GridCell}"
                              RowStyle="{StaticResource GridRow}"
                              AutomationProperties.Name="WebSocket logical messages">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="IdColumn" Header="ID">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="{Binding DirectionLabel}"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="Arrow" Text="{Binding Arrow}" FontWeight="ExtraBold" FontSize="14"
                                                       Foreground="{DynamicResource Saz.Warn}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding IdText}" FontFamily="{StaticResource Saz.MonoFont}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DirectionKey}" Value="Client">
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Saz.DirClient}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DirectionKey}" Value="Server">
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Saz.DirServer}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="TypeColumn" Header="Type">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ListType}" Style="{StaticResource MessageText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="BodyColumn" Header="Body">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Body" Text="{Binding Body}" ToolTip="{Binding BodyToolTip}" HorizontalAlignment="Right"
                                                   Style="{StaticResource MessageText}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLimited}" Value="True">
                                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Saz.Warn}" />
                                                <Setter TargetName="Body" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="PreviewColumn" Header="Preview" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Preview}" ToolTip="{Binding Preview}" Style="{StaticResource MessageText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Saz.Muted}" HorizontalAlignment="Center"
                               Margin="14,40,14,14" TextWrapping="Wrap" IsHitTestVisible="False"
                               Visibility="{Binding EmptyText, Converter={StaticResource NotNullToVisibility}}" />
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Grid.Row="0" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="12" DragIncrement="1"
                      Focusable="True" IsTabStop="True" Background="{DynamicResource Saz.Line}"
                      FocusVisualStyle="{StaticResource Saz.InsetFocusVisual}"
                      AutomationProperties.Name="Resize WebSocket traffic and payload panes"
                      ToolTip="Drag or use Left and Right arrow keys to resize the WebSocket panes"
                      DragCompleted="OnSplitterDragCompleted" KeyUp="OnSplitterKeyUp" />

        <!-- Selected message detail. -->
        <Border x:Name="DetailPane" Grid.Column="2" Grid.Row="0" Style="{StaticResource Pane}"
                AutomationProperties.Name="Selected WebSocket message">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                    <TextBlock.Text>
                        <PriorityBinding>
                            <Binding Path="Detail.Heading" />
                            <Binding Source="Selected WebSocket message" />
                        </PriorityBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Saz.Line}" BorderThickness="0,1,0,0" />
                <Border DockPanel.Dock="Top" Style="{StaticResource Saz.Warning}" Margin="10,8,10,0"
                        Visibility="{Binding EmptyText, Converter={StaticResource NotNullToVisibility}}">
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" />
                </Border>
                <DockPanel DataContext="{Binding Detail}" Margin="10,0,10,10"
                           Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="{DynamicResource Saz.Muted}" Margin="0,7"
                               TextWrapping="Wrap" />
                    <Border DockPanel.Dock="Top" Style="{StaticResource Saz.Warning}"
                            Visibility="{Binding Warning, Converter={StaticResource NotNullToVisibility}}">
                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
                    </Border>
                    <views:ActiveSearchBar x:Name="PayloadSearch" DockPanel.Dock="Top" DataContext="{Binding Search}" />
                    <views:MessagePaneView />
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
