<UserControl x:Class="SazViewer.App.Views.ValueTreeView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views"
             xmlns:controls="clr-namespace:SazViewer.App.Controls"
             xmlns:vm="clr-namespace:SazViewer.App.ViewModels">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <ListBox x:Name="Rows"
             ItemsSource="{Binding VisibleRows}"
             SelectionMode="Extended"
             Background="{DynamicResource Saz.Panel}"
             Foreground="{DynamicResource Saz.Text}"
             BorderBrush="{DynamicResource Saz.Line}"
             BorderThickness="1"
             Padding="3,3,4,8"
             FontFamily="{StaticResource Saz.MonoFont}"
             FontSize="12"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             KeyboardNavigation.TabNavigation="Once"
             AutomationProperties.Name="{Binding AccessibleName}"
             PreviewKeyDown="OnRowsKeyDown"
             MouseDoubleClick="OnRowsDoubleClick">
        <ListBox.CommandBindings>
            <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
        </ListBox.CommandBindings>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Saz.InsetFocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding ItemStatus}" />
                <Setter Property="AutomationProperties.PositionInSet" Value="{Binding PositionInSet}" />
                <Setter Property="AutomationProperties.SizeOfSet" Value="{Binding SizeOfSet}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Chrome" Background="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Saz.Selected}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Saz.SelectedText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TreeRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:TreeGuides Depth="{Binding Depth}" Stroke="{DynamicResource Saz.Muted}" />
                    <Border x:Name="Expander" Grid.Column="1" Width="13" Height="16" Margin="0,2,4,2" VerticalAlignment="Top"
                            BorderThickness="1" BorderBrush="{DynamicResource Saz.Line}" Background="{DynamicResource Saz.Panel2}"
                            Cursor="Hand" MouseLeftButtonDown="OnExpanderMouseDown">
                        <TextBlock Text="{Binding ExpanderGlyph}" FontSize="11" LineHeight="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Saz.Text}" />
                    </Border>
                    <controls:RichLine Grid.Column="2" Line="{Binding Line}" Version="{Binding Line.Version}" TextWrapping="Wrap"
                                       VerticalAlignment="Top" Margin="0,2" />
                    <controls:RichLine Grid.Column="3" Line="{Binding MetaLine}" Version="{Binding MetaLine.Version}"
                                       Foreground="{DynamicResource Saz.Muted}" FontSize="11" Margin="12,3,0,2"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding MetaLine, Converter={StaticResource NotNullToVisibility}}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsExpandable}" Value="False">
                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStatus}" Value="True">
                        <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
