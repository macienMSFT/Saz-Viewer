<UserControl x:Class="SazViewer.App.Views.ActiveSearchBar" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <DockPanel Margin="0,6">
        <Button DockPanel.Dock="Right" Content="Next" Margin="4,0,0,0" Command="{Binding NextCommand}"
                AutomationProperties.Name="Next active-view search match" ToolTip="Next match (Enter)" />
        <Button DockPanel.Dock="Right" Content="Previous" Margin="6,0,0,0" Command="{Binding PreviousCommand}"
                AutomationProperties.Name="Previous active-view search match" ToolTip="Previous match (Shift+Enter)" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource Saz.Muted}" VerticalAlignment="Center"
                   Margin="8,0,0,0" MinWidth="70" AutomationProperties.LiveSetting="Polite" />
        <TextBox x:Name="QueryBox"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                 Tag="{Binding Placeholder}"
                 AutomationProperties.Name="{Binding AccessibleName}"
                 PreviewKeyDown="OnQueryKeyDown" />
    </DockPanel>
</UserControl>
