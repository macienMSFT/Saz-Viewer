<UserControl x:Class="SazViewer.App.Views.ImageView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Meta" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Saz.Muted}" />
                <Setter Property="Margin" Value="0,0,14,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4" AutomationProperties.Name="Image metadata">
            <TextBlock Style="{StaticResource Meta}" Text="{Binding MimeType}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Saz.Text}" />
            <TextBlock Style="{StaticResource Meta}" Text="{Binding SizeText}" />
            <TextBlock Style="{StaticResource Meta}" Text="{Binding Animation}" />
            <TextBlock Style="{StaticResource Meta}" Text="{Binding Dimensions}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Detection}" Foreground="{DynamicResource Saz.Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,4" />
        <Border DockPanel.Dock="Top" Style="{StaticResource Saz.Warning}"
                Visibility="{Binding Warning, Converter={StaticResource NotNullToVisibility}}">
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Saz.Text}" />
        </Border>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap"
                   Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Saz.Muted}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Saz.Warn}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Border BorderBrush="{DynamicResource Saz.Line}" BorderThickness="1" Margin="0,4,0,0" Padding="4"
                HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True"
                FocusVisualStyle="{StaticResource Saz.InsetFocusVisual}"
                AutomationProperties.Name="Image preview"
                Visibility="{Binding Image, Converter={StaticResource NotNullToVisibility}}">
            <Border.Background>
                <!-- Checkerboard so transparent pixels are visible in both themes. -->
                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                            <GeometryDrawing Brush="#FFE0E0E0" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
            <!-- Shown at natural size, scaled down (never up) to fit the pane. -->
            <Viewbox StretchDirection="DownOnly">
                <Image Source="{Binding Image}" Width="{Binding PixelWidth}" Height="{Binding PixelHeight}"
                       Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{Binding MimeType, StringFormat='Decoded {0} image'}" />
            </Viewbox>
        </Border>
    </DockPanel>
</UserControl>
