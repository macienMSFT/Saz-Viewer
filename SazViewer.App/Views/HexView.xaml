<UserControl x:Class="SazViewer.App.Views.HexView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Saz.Text}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="HexView byte source"
                        KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton Style="{StaticResource Saz.ButtonBase}" Content="Captured" Margin="0,0,2,0"
                             IsEnabled="{Binding CanShowCaptured}"
                             IsChecked="{Binding IsCaptured, Mode=TwoWay}" AutomationProperties.Name="Captured bytes" />
                <RadioButton Style="{StaticResource Saz.ButtonBase}" Content="Decoded"
                             IsEnabled="{Binding CanShowDecoded}"
                             IsChecked="{Binding IsDecoded, Mode=TwoWay}" AutomationProperties.Name="Decoded bytes"
                             ToolTipService.ShowOnDisabled="True"
                             ToolTip="Decoded bytes are available only when content codings were removed." />
            </StackPanel>
            <TextBlock Text="{Binding RemovedEncodingsText}" Foreground="{DynamicResource Saz.Muted}"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       Visibility="{Binding RemovedEncodingsText, Converter={StaticResource NotNullToVisibility}}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource Saz.Muted}"
                   TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
        <ContentControl Content="{Binding Document}" Focusable="False"
                        AutomationProperties.Name="{Binding DumpAccessibleName}" />
    </DockPanel>
</UserControl>
