<UserControl x:Class="SazViewer.App.Views.WebPreviewView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="WebView mode"
                        KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton Style="{StaticResource Saz.ButtonBase}" Content="Rendered" Margin="0,0,2,0"
                             IsChecked="{Binding IsRenderedMode, Mode=TwoWay}" AutomationProperties.Name="Rendered" />
                <RadioButton Style="{StaticResource Saz.ButtonBase}" Content="Source"
                             IsChecked="{Binding IsSourceMode, Mode=TwoWay}" AutomationProperties.Name="Source" />
            </StackPanel>
            <TextBlock Text="{Binding Detection}" Foreground="{DynamicResource Saz.Muted}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="10,0,0,0" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6"
                   AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Saz.Muted}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Saz.Warn}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Grid>
            <Border x:Name="Host" BorderBrush="{DynamicResource Saz.Line}" BorderThickness="1"
                    AutomationProperties.Name="Inert HTML preview"
                    Visibility="{Binding IsRenderedMode, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding SourceDocument}" Focusable="False"
                            AutomationProperties.Name="Decoded HTML source"
                            Visibility="{Binding IsSourceMode, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
