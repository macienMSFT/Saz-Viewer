<UserControl x:Class="SazViewer.App.Views.LineDocumentView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views"
             xmlns:controls="clr-namespace:SazViewer.App.Controls"
             xmlns:vm="clr-namespace:SazViewer.App.ViewModels">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <ListBox x:Name="Rows"
             ItemsSource="{Binding Document.VisibleRows}"
             SelectionMode="Extended"
             Background="{DynamicResource Saz.Bg}"
             Foreground="{DynamicResource Saz.Text}"
             BorderBrush="{DynamicResource Saz.Line}"
             BorderThickness="1"
             Padding="6,4"
             FontFamily="{StaticResource Saz.MonoFont}"
             FontSize="12.5"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             KeyboardNavigation.TabNavigation="Once"
             AutomationProperties.Name="{Binding AccessibleName, RelativeSource={RelativeSource AncestorType=UserControl}}"
             PreviewMouseLeftButtonUp="OnRowsMouseUp"
             KeyDown="OnRowsKeyDown">
        <ListBox.CommandBindings>
            <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
        </ListBox.CommandBindings>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Saz.InsetFocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LineKind.Heading}">
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Padding" Value="0,10,0,4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LineKind.FormatMeta}">
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="Padding" Value="0,2,0,4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LineKind.Muted}">
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="Foreground" Value="{DynamicResource Saz.Muted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LineKind.Toggle}">
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="Padding" Value="0,8,0,4" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="AutomationProperties.HelpText" Value="Press Enter or Space to expand or collapse." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LineKind.Warning}">
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Saz.WarningBg}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Saz.Warn}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="4,0,0,0" />
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Margin" Value="0,4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LineKind.DecodeStatus}">
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Saz.InfoBg}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Saz.Accent}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="4,0,0,0" />
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Margin" Value="0,4" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Saz.Selected}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Saz.SelectedText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DocumentLine}">
                <controls:RichLine Line="{Binding}" Version="{Binding Version}" TextWrapping="Wrap" />
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
