<UserControl x:Class="SazViewer.App.Views.InspectorView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views"
             xmlns:controls="clr-namespace:SazViewer.App.Controls"
             Background="{DynamicResource Saz.Bg}"
             Foreground="{DynamicResource Saz.Text}"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <DockPanel Margin="10,6,10,8">
        <!-- Header: title, Previous / Next, position, close. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCommand}" Margin="8,0,0,0"
                    AutomationProperties.Name="Close inspector" ToolTip="Close inspector (Esc)" />
            <controls:ThemeToggleButton x:Name="ThemeButton" DockPanel.Dock="Right" Margin="8,0,0,0" />
            <Button x:Name="PopOutButton" DockPanel.Dock="Right" Content="⧉" Command="{Binding PopOutCommand}" Margin="4,0,0,0"
                    Visibility="{Binding CanPopOut, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Open in new window" ToolTip="Open in new window" />
            <Button x:Name="LayoutButton" DockPanel.Dock="Right" Command="{Binding ToggleLayoutCommand}" Margin="4,0,0,0"
                    Visibility="{Binding IsHttp, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{Binding LayoutToggleLabel}" ToolTip="{Binding LayoutToggleLabel}">
                <Grid Width="16" Height="14">
                    <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" RadiusX="1.5" RadiusY="1.5" />
                    <Rectangle Width="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"
                               Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Position}" Foreground="{DynamicResource Saz.Muted}" VerticalAlignment="Center"
                       Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding Position, StringFormat='Session {0}'}" />
            <Button x:Name="NextButton" DockPanel.Dock="Right" Content="Next ▶" Command="{Binding NextCommand}" Margin="4,0,0,0"
                    AutomationProperties.Name="Next session" ToolTip="Next session (Alt+Right)" />
            <Button x:Name="PreviousButton" DockPanel.Dock="Right" Content="◀ Previous" Command="{Binding PreviousCommand}" Margin="8,0,0,0"
                    AutomationProperties.Name="Previous session" ToolTip="Previous session (Alt+Left)" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" AutomationProperties.HeadingLevel="Level2" />
        </DockPanel>

        <!-- Session details (endpoints, timers, warnings). -->
        <Expander DockPanel.Dock="Top" Header="Session details" Margin="0,2,0,4" DataContext="{Binding Details}"
                  Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Visibility="{Binding HasEndpoints, Converter={StaticResource BoolToVisibility}}" Margin="0,2">
                    <Run Text="Endpoints:" FontWeight="SemiBold" /> <Run Text="{Binding Endpoints, Mode=OneWay}" />
                </TextBlock>
                <Expander Header="Timers" Visibility="{Binding HasTimers, Converter={StaticResource BoolToVisibility}}" Margin="0,2">
                    <TextBox Text="{Binding Timers, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Saz.MonoFont}" FontSize="12"
                             AutomationProperties.Name="Session timers" />
                </Expander>
                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Saz.Warning}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <Grid>
            <!-- HTTP single view: Request / Response selector, active-view search and the selected side. -->
            <DockPanel x:Name="HttpBody" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                <TabControl x:Name="SideTabs" DockPanel.Dock="Top" Style="{StaticResource Saz.TabStripOnly}"
                            SelectedIndex="{Binding SelectedSideIndex, Mode=TwoWay}"
                            AutomationProperties.Name="Session message">
                    <TabItem Header="Request" AutomationProperties.Name="Request" />
                    <TabItem Header="Response" AutomationProperties.Name="Response" />
                </TabControl>
                <views:ActiveSearchBar x:Name="SearchBar" DockPanel.Dock="Top" DataContext="{Binding Search}" />
                <ContentControl x:Name="PaneHost" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSingle}" Value="True">
                                    <Setter Property="Content" Value="{Binding ActivePane}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DockPanel>
            <!-- HTTP split view: labelled Request and Response panes, each with its own search; stacked when narrow. -->
            <Grid x:Name="SplitBody" Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SplitFirstColumn" Width="*" MinWidth="320" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="SplitSecondColumn" Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SplitFirstRow" Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="SplitSecondRow" Height="0" />
                </Grid.RowDefinitions>
                <DockPanel x:Name="RequestSplitPane" Grid.Column="0" AutomationProperties.Name="Request">
                    <TextBlock DockPanel.Dock="Top" Text="Request" FontWeight="SemiBold" Margin="2,2,0,4" AutomationProperties.HeadingLevel="Level3" />
                    <views:ActiveSearchBar x:Name="RequestSearchBar" DockPanel.Dock="Top" DataContext="{Binding RequestSearch}" />
                    <ContentControl Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSplit}" Value="True">
                                        <Setter Property="Content" Value="{Binding Request}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DockPanel>
                <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" KeyboardIncrement="12" Focusable="True"
                              Background="Transparent" BorderBrush="{DynamicResource Saz.Border}" BorderThickness="1,0,0,0" Margin="4,0"
                              AutomationProperties.Name="Resize Request and Response panes" ToolTip="Drag or use arrow keys to resize"
                              PreviewKeyDown="OnSplitterKeyDown" />
                <DockPanel x:Name="ResponseSplitPane" Grid.Column="2" AutomationProperties.Name="Response">
                    <TextBlock DockPanel.Dock="Top" Text="Response" FontWeight="SemiBold" Margin="2,2,0,4" AutomationProperties.HeadingLevel="Level3" />
                    <views:ActiveSearchBar x:Name="ResponseSearchBar" DockPanel.Dock="Top" DataContext="{Binding ResponseSearch}" />
                    <ContentControl Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSplit}" Value="True">
                                        <Setter Property="Content" Value="{Binding Response}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DockPanel>
            </Grid>
            <!-- WebSocket sessions: message list and selected message detail. -->
            <views:WebSocketInspectorView x:Name="WebSocketView" DataContext="{Binding WebSocket}"
                                          Visibility="{Binding Converter={StaticResource NotNullToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
