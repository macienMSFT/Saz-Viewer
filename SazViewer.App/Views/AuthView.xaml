<UserControl x:Class="SazViewer.App.Views.AuthView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SazViewer.App.Views"
             xmlns:vm="clr-namespace:SazViewer.App.ViewModels">
    <UserControl.Resources>
        <views:SharedResourceDictionary Source="pack://application:,,,/SazViewer.App;component/Views/ViewResources.xaml" />
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Saz.Warning}" Margin="0,0,0,6">
            <TextBlock Text="{x:Static vm:AuthViewModel.Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Saz.Text}" />
        </Border>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Style="{StaticResource Saz.ButtonBase}" Content="{Binding ButtonText}"
                    Command="{Binding ToggleCommand}"
                    AutomationProperties.Name="{Binding ButtonAccessibleName}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Saz.Muted}" VerticalAlignment="Center"
                       Margin="10,0,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ContentControl Content="{Binding Document}" Focusable="False" AutomationProperties.Name="Authentication headers" />
    </DockPanel>
</UserControl>
