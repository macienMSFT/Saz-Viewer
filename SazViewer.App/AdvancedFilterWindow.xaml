<Window x:Class="SazViewer.App.AdvancedFilterWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SazViewer.App.Views"
        Width="900" Height="450" MinWidth="680" MinHeight="320"
        Background="{DynamicResource Saz.Bg}"
        Foreground="{DynamicResource Saz.Text}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="Manual"
        Icon="pack://application:,,,/SazViewer.App;component/Assets/SazViewer.ico"
        ShowInTaskbar="True"
        AutomationProperties.Name="Advanced session filter">
    <views:AdvancedFilterView x:Name="FilterView" />
</Window>
