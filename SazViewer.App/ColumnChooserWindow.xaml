<Window x:Class="SazViewer.App.ColumnChooserWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session columns" Width="780" Height="620" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Saz.Bg}" Foreground="{DynamicResource Saz.Text}"
        FontFamily="Segoe UI" FontSize="13"
        AutomationProperties.Name="Customize session columns">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,10"
                 Tag="Search available columns..."
                 TextChanged="OnSearchChanged"
                 AutomationProperties.Name="Search available session columns" />

        <ListView x:Name="ColumnList" Grid.Row="1"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  Background="{DynamicResource Saz.Panel}" Foreground="{DynamicResource Saz.Text}"
                  BorderBrush="{DynamicResource Saz.Border}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Available session columns">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Saz.Panel}" />
                    <Setter Property="Foreground" Value="{DynamicResource Saz.Text}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Saz.Border}" />
                    <Setter Property="Padding" Value="8,5" />
                </Style>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource Saz.Text}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="2" />
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="58" Header="Show">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding ToggleName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="210" Header="Column" DisplayMemberBinding="{Binding Header}" />
                    <GridViewColumn Width="190" Header="Category" DisplayMemberBinding="{Binding Category}" />
                    <GridViewColumn Width="250" Header="Source" DisplayMemberBinding="{Binding Source}" />
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Move _up" Click="OnMoveUp" Padding="10,4" Margin="0,0,6,0"
                    AutomationProperties.Name="Move selected column up" />
            <Button Content="Move _down" Click="OnMoveDown" Padding="10,4" Margin="0,0,14,0"
                    AutomationProperties.Name="Move selected column down" />
            <Button Content="Request _header…" Click="OnAddRequestHeader" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="Response h_eader…" Click="OnAddResponseHeader" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="Session _flag…" Click="OnAddSessionFlag" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="_Reset columns to default" Click="OnReset" Padding="10,4" />
        </WrapPanel>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Checked columns appear from top to bottom; drag headers in the grid for quick reordering."
                       Foreground="{DynamicResource Saz.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="_Cancel" IsCancel="True" MinWidth="82" Padding="10,4" Margin="10,0,6,0" />
                <Button Content="_OK" IsDefault="True" MinWidth="82" Padding="10,4" Click="OnAccept" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
